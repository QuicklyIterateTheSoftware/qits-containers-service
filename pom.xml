<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- qits-containers — the platform's container orchestrator.

         Five modules of the platform shell out to the docker CLI today, each with its own registry,
         its own labels and its own answer to "what happens to a running container when the module
         restarts". This service is the one place that decides: a durable row is written BEFORE the
         container is started, a boot sweep ADOPTS what is still running, and no code path removes a
         container that no row names.

         Three modules, and the edges are why there are three:

           core     the domain: the registry rows, the spec and policy vocabulary, the docker seam.
                    A plain library jar. It owns the datasource, the persistence unit and the
                    Flyway lineage.
           client   what a consumer depends on to CALL this service. It depends on `core` NOT AT
                    ALL, deliberately: a caller needs the wire types and an HttpClient, and a
                    dependency on the domain would drag this service's entities, its Flyway
                    lineage and its datasource defaults into every consumer.
           service  the deployable: the REST surface, the real docker driver, the sweeps.

         Versions that must stay in step with the rest of the platform (the Quarkus platform, the
         JDK release) are duplicated here on purpose: a clone of THIS repo alone must build, with no
         monorepo and no parent to inherit from. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-containers</artifactId>
    <version>2026.905.183518</version>
    <packaging>pom</packaging>
    <name>qits-containers</name>

    <modules>
        <!-- Libraries before the app. `service` depends on both; neither depends on the other. -->
        <module>core</module>
        <module>client</module>
        <module>service</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <failsafe-plugin.version>${surefire-plugin.version}</failsafe-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>

        <!-- The platform's datasource resilience, released together out of
             libs/qits-integrations-quarkus, which is why the two versions are one string.
             qits-db-core carries PatientPgDriver — the class the datasource block NAMES, so it has
             to be on the runtime classpath of whatever ships `core` — and DbRetry/DbRetry.inNewTx,
             the read and write seams. qits-arch-rules carries the test that fails this build when a
             postgresql datasource is missing a line of that block. They move together: the rule
             names the driver as a string, so a driver that moved without the rule would pass a
             build it should fail. -->
        <qits.db-core.version>2026.904.82648</qits.db-core.version>
        <qits.arch-rules.version>2026.904.82648</qits.arch-rules.version>

        <!-- Machine identity, released out of the same libs/qits-integrations-quarkus train. It is
             the fourth platform jar this repo takes and the one AGENTS.md's "nothing else may
             follow them in" had to be widened for: every route of this service is addressed to an
             owner, the owner IS the caller, and the platform already has exactly one answer to
             "who is calling" — MachineAuth plus the rollout gate every sibling shares. A second
             answer invented here would be the interim static token the platform has a standing
             decision against. It brings no server and no transport: quarkus-oidc validates the
             bearer and this jar only reads the identity that validation leaves behind. -->
        <qits.auth-core.version>2026.904.82648</qits.auth-core.version>

        <!-- The platform event bus client. It is here from the scaffold rather than from the first
             event, because it brings the causation persistence trio (CausedRow, CausationStamp,
             @Uncaused) that every row this service writes has to decide about — see ArchRulesTest —
             and its own datasource, persistence unit and Flyway lineage. Adding it later would be a
             flag day: a second store appears in the deployment spec and in every suite at once. -->
        <qits.eventstream.version>2026.904.82646</qits.eventstream.version>

        <!-- The user-story framework (test scope). This repository's userflow catalogue is six IT
             classes on one profile — api/TokenValidationBootstrapIT plus service/…/stories/** — so
             naming them in a `mvn verify -DskipITs=false` regenerates service/target/userstories/:
             the stories' documentation, network diagrams included, OBSERVED rather than narrated.
             This version is also the one that ships NetworkTaps, which replaced the local
             StoryNetworkFilter this repo used to carry. It has a version of its own rather than
             riding the three above, because it is released out of libs/qits-userflows and not out
             of the qits-integrations-quarkus reactor. -->
        <qits.userflows.version>2026.904.223009</qits.userflows.version>

        <!-- The recording service mocks the same IT boots against (the generic MockService plus
             idp.MockIdp), released out of libs/qits-integrations-quarkus like qits-db-core,
             qits-arch-rules and qits-auth-core above — so the same-string policy those three follow
             applies the day this repo consumes a newer reactor, and until then this names the
             release the mock idp arrived in. -->
        <qits.service-mock.version>2026.904.82648</qits.service-mock.version>

        <qits.maven.repository.url>http://registry.dev.localhost:8080/artifacts/maven/maven</qits.maven.repository.url>

        <!-- Real PostgreSQL binaries, resolved as ordinary Maven artifacts and spawned as a child
             process by the suite. The platform convention: a clone tests green with NO DOCKER, which
             rules out Testcontainers and Quarkus dev services alike — and it matters more here than
             anywhere, because this is the repository whose subject IS docker. A suite that needed a
             daemon to test the orchestrator could never say what the orchestrator does without one.

             Two coordinates, on purpose. The BOM pins which POSTGRES the binaries are (18.4.0, the
             tag the platform's own qits-oci-postgresql image is built from), the library version is
             the harness around them, and they move independently. -->
        <zonky.embedded-postgres.version>2.2.2</zonky.embedded-postgres.version>
        <zonky.postgres-binaries.version>18.4.0</zonky.postgres-binaries.version>

        <!-- Integration tests run against a PACKAGED artifact, so a plain `mvn verify` skips them.
             The `native` profile in service/pom.xml flips it. -->
        <skipITs>true</skipITs>

        <!-- JUnit tags failsafe must NOT run, empty by default so `-DskipITs=false` still means
             "run everything". Only the `native` profile sets it, to `extended`: that build wants
             the @QuarkusIntegrationTest against the binary it just compiled, while the
             docker-backed proof (ContainersRestartAdoptionIT) is an infrastructure test with
             nothing to say about native-image. It is still run, unchanged, by `-DskipITs=false`.
             Same shape and same property name as qits-ci. -->
        <qits.it.excluded-groups/>

        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Which postgres the embedded binaries ARE. Imported as a BOM because the per-arch
                     artifacts are separate coordinates. -->
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${zonky.postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${zonky.embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- The platform jars this repo consumes. -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-db-core</artifactId>
                <version>${qits.db-core.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-eventstream</artifactId>
                <version>${qits.eventstream.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at the declaration site: the rules run in the build and ship in
                     nothing. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-arch-rules</artifactId>
                <version>${qits.arch-rules.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-auth-core</artifactId>
                <version>${qits.auth-core.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site, like qits-arch-rules: the framework runs
                     in the build and ships in nothing. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-userflows</artifactId>
                <version>${qits.userflows.version}</version>
            </dependency>
            <dependency>
                <!-- Test scope at every declaration site, for the same reason. -->
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-service-mock</artifactId>
                <version>${qits.service-mock.version}</version>
            </dependency>
            <!-- The reactor's own modules, so `service` depends on them version-less. -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-containers-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>qits-containers-client</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!-- The platform's own Maven repository, where qits-db-core, qits-arch-rules and
             qits-eventstream are published. The id is what a locally cached copy is recorded under,
             so it has to stay `qits-maven` or an offline build refuses an artifact it already has. -->
        <repository>
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>make-index</id>
                            <goals>
                                <goal>jandex</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
